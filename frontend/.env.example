# =============================================================
# Customer Support System — Frontend Environment Variables
# Copy this file to frontend/.env and fill in the values.
# Never commit frontend/.env to version control.
# =============================================================

# URL of the Django API backend.
# Defaults to http://127.0.0.1:8000 for local development.
# Set this to the production API URL before building/deploying.
VITE_API_BASE_URL=
