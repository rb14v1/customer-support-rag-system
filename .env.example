# =============================================================
# Customer Support System — Environment Variables
# Copy this file to .env and fill in the values before running.
# Never commit .env to version control.
# =============================================================

# ------------------------------------------------------------
# Django — Security
# ------------------------------------------------------------
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=

# ------------------------------------------------------------
# Database
# Provide a DATABASE_URL in standard URL form, e.g.:
#   postgresql://user:password@host:5432/dbname
# Defaults to SQLite for local development when unset.
# ------------------------------------------------------------
DATABASE_URL=
DB_CONN_MAX_AGE=

# ------------------------------------------------------------
# OIDC / OAuth2 (mozilla-django-oidc)
# ------------------------------------------------------------
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
OIDC_RP_SIGN_ALGO=
OIDC_OP_AUTHORIZATION_ENDPOINT=
OIDC_OP_TOKEN_ENDPOINT=
OIDC_OP_USER_ENDPOINT=
OIDC_OP_JWKS_ENDPOINT=
LOGIN_REDIRECT_URL=
LOGOUT_REDIRECT_URL=

# ------------------------------------------------------------
# RAG — Configuration
# ------------------------------------------------------------
DATA_DIR=
DEFAULT_CHUNK_SIZE=
DEFAULT_CHUNK_OVERLAP=
DEFAULT_TOP_K=
RAG_MIN_RELEVANCE_SCORE=
RAG_MIN_QDRANT_SCORE=

# ------------------------------------------------------------
# Azure OpenAI
# ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# ------------------------------------------------------------
# Azure AI Search
# ------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=

# ------------------------------------------------------------
# Azure Blob Storage
# ------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=

# ------------------------------------------------------------
# Qdrant
# ------------------------------------------------------------
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# ------------------------------------------------------------
# Database Backup (Azure Blob — separate region from primary)
# ------------------------------------------------------------
AZURE_BACKUP_STORAGE_CONNECTION_STRING=
AZURE_BACKUP_CONTAINER_NAME=
DB_BACKUP_RETENTION_DAYS=
